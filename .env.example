# Copy to .env for local Compose. Never commit real keys.
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# DeepSeek: disable thinking for bounded extraction/review calls. Leave empty for other providers unless supported.
LLM_THINKING_TYPE=disabled
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
KB_RETRIEVAL_STRATEGY=bm25_hash
# Set to the tested commit before capturing evaluation/video evidence.
BUILD_COMMIT=unknown
