{
  "version": "demo-kb-v1",
  "documents": [
    {
      "id": 1001,
      "name": "采购审批制度（演示）",
      "version": "2.0",
      "demo": true,
      "chunks": [
        {
          "id": 10001,
          "section": "第1条",
          "text": "采购申请金额不超过3万元时，由部门采购主管审批；超过3万元时还需财务复核。"
        },
        {
          "id": 10002,
          "section": "第2条",
          "text": "普通采购申请须在提交后3个工作日内完成审批，法定节假日不计入工作日。"
        },
        {
          "id": 10003,
          "section": "第3条",
          "text": "紧急采购须填写停线风险和最迟到货时间，经主管批准后才可采用加急流程。"
        },
        {
          "id": 10004,
          "section": "第4条",
          "text": "审批人不得审批本人发起的申请，应转交具有同等权限的另一位主管。"
        },
        {
          "id": 10005,
          "section": "第5条",
          "text": "退回修改的申请须说明退回原因；重新提交后重新计算审批期限。"
        },
        {
          "id": 10006,
          "section": "第6条",
          "text": "采购申请在审批完成前可以撤回，已生成订单的申请不得直接删除。"
        },
        {
          "id": 10007,
          "section": "第7条",
          "text": "预算不足时暂停采购审批；补充预算通过前不得以拆单方式绕过金额门槛。"
        },
        {
          "id": 10008,
          "section": "第8条",
          "text": "审批意见与附件保存5年，查看记录仍受部门权限限制。"
        }
      ]
    },
    {
      "id": 1002,
      "name": "供应商准入规范（演示）",
      "version": "2.0",
      "demo": true,
      "chunks": [
        {
          "id": 10101,
          "section": "第1条",
          "text": "新增供应商须提供营业执照、联系人和供货范围；缺少任一项不得启用。"
        },
        {
          "id": 10102,
          "section": "第2条",
          "text": "供应商资质到期前30个自然日发出续期提示，到期后不得创建新采购订单。"
        },
        {
          "id": 10103,
          "section": "第3条",
          "text": "同一物料应维护至少2家候选供应商；独家采购须说明不可替代理由并经主管确认。"
        },
        {
          "id": 10104,
          "section": "第4条",
          "text": "供应商银行账户变更须由采购主管和财务分别核验，聊天消息不能替代书面确认。"
        },
        {
          "id": 10105,
          "section": "第5条",
          "text": "供应商停用不删除历史订单和验收记录，未完成订单须指定后续处理人。"
        },
        {
          "id": 10106,
          "section": "第6条",
          "text": "试供期为60个自然日，试供期内每批到货都需登记验收结果。"
        },
        {
          "id": 10107,
          "section": "第7条",
          "text": "供应商质量评分低于80分时进入复评，复评结果不直接改变历史验收数据。"
        },
        {
          "id": 10108,
          "section": "第8条",
          "text": "供应商联系电话只用于采购联络，不得写入公开演示截图。"
        }
      ]
    },
    {
      "id": 1003,
      "name": "订单交付规则（演示）",
      "version": "2.0",
      "demo": true,
      "chunks": [
        {
          "id": 10201,
          "section": "第1条",
          "text": "采购订单经审批通过后才可登记到货，草稿订单不得进入验收环节。"
        },
        {
          "id": 10202,
          "section": "第2条",
          "text": "订单交货日期到期且仍有未交付数量时标记逾期，提前交货不产生逾期天数。"
        },
        {
          "id": 10203,
          "section": "第3条",
          "text": "分批到货累计数量不得超过订单数量；超量到货应先完成订单变更审批。"
        },
        {
          "id": 10204,
          "section": "第4条",
          "text": "交付进度登记只记录供应商反馈，库存和已交付数量由确认入库后同步更新。"
        },
        {
          "id": 10205,
          "section": "第5条",
          "text": "订单价格变更必须保留原价、新价和变更原因，不得覆盖原始审批证据。"
        },
        {
          "id": 10206,
          "section": "第6条",
          "text": "订单已发生入库后不得直接反审，应先核对入库和库存流水。"
        },
        {
          "id": 10207,
          "section": "第7条",
          "text": "取消剩余交付须记录关闭原因，已完成交付的历史数量继续保留。"
        },
        {
          "id": 10208,
          "section": "第8条",
          "text": "货期变更至少提前2个工作日通知采购主管，突发停产应立即登记异常。"
        }
      ]
    },
    {
      "id": 1004,
      "name": "到货验收办法（演示）",
      "version": "2.0",
      "demo": true,
      "chunks": [
        {
          "id": 10301,
          "section": "第1条",
          "text": "到货登记时核对订单、物料和数量；数量不一致时先记录异常再提交验收。"
        },
        {
          "id": 10302,
          "section": "第2条",
          "text": "合格数量与不合格数量之和必须等于到货数量，不允许出现负数。"
        },
        {
          "id": 10303,
          "section": "第3条",
          "text": "不合格品不得直接生成普通入库单，须退换货或完成让步接收批准。"
        },
        {
          "id": 10304,
          "section": "第4条",
          "text": "让步接收须由采购主管确认并填写理由；仓管员不得自行豁免质量要求。"
        },
        {
          "id": 10305,
          "section": "第5条",
          "text": "需要抽样时抽样比例为10%，发现关键缺陷后改为全量检验。"
        },
        {
          "id": 10306,
          "section": "第6条",
          "text": "验收照片按批次保存，发现包装破损应记录承运信息。"
        },
        {
          "id": 10307,
          "section": "第7条",
          "text": "验收完成后24小时内登记结果；易腐物料到货后应立即验收。"
        },
        {
          "id": 10308,
          "section": "第8条",
          "text": "已生成入库单的验收记录不得直接修改数量，应先处理关联入库单。"
        }
      ]
    },
    {
      "id": 1005,
      "name": "入库操作手册（演示）",
      "version": "2.0",
      "demo": true,
      "chunks": [
        {
          "id": 10401,
          "section": "第1条",
          "text": "1. 打开采购入库页面并选择草稿单。\n2. 核对批次号、库位和数量。\n3. 点击确认并核对库存流水。"
        },
        {
          "id": 10402,
          "section": "第2条",
          "text": "同一张入库单只能确认成功一次，重复确认不应再次增加库存。"
        },
        {
          "id": 10403,
          "section": "第3条",
          "text": "作废已确认入库单须填写原因，系统冲减库存并保留原流水和冲减流水。"
        },
        {
          "id": 10404,
          "section": "第4条",
          "text": "库存已被后续业务占用且冲减后数量为负时，必须拒绝作废。"
        },
        {
          "id": 10405,
          "section": "第5条",
          "text": "草稿单可以编辑；确认后不得直接编辑批次号和库位。"
        },
        {
          "id": 10406,
          "section": "第6条",
          "text": "1. 打开到货验收详情。\n2. 核对合格数量与已生成数量。\n3. 选择本次入库数量并生成草稿单。"
        },
        {
          "id": 10407,
          "section": "第7条",
          "text": "公共库存与项目库存分别记账，项目库存须填写项目归属。"
        },
        {
          "id": 10408,
          "section": "第8条",
          "text": "入库确认任一步骤失败时，单据状态、库存余额、库存流水和订单回写应一起回滚。"
        }
      ]
    },
    {
      "id": 1006,
      "name": "库存盘点规范（演示）",
      "version": "2.0",
      "demo": true,
      "chunks": [
        {
          "id": 10501,
          "section": "第1条",
          "text": "可用库存等于库存数量减冻结数量再减预留数量，不等于账面库存总量。"
        },
        {
          "id": 10502,
          "section": "第2条",
          "text": "仓管员只能查看被授权仓库的库存，跨仓库查询需另行授权。"
        },
        {
          "id": 10503,
          "section": "第3条",
          "text": "可用量低于物料预警下限时列入短缺清单，缺口为预警下限减可用量。"
        },
        {
          "id": 10504,
          "section": "第4条",
          "text": "盘点每月开展1次，盘点差异须经复核后登记处理意见。"
        },
        {
          "id": 10505,
          "section": "第5条",
          "text": "冻结库存须记录冻结原因和责任人，解除冻结需经过原授权流程。"
        },
        {
          "id": 10506,
          "section": "第6条",
          "text": "同一物料的不同批次分别保存数量，批次追溯关联入库单、订单和供应商。"
        },
        {
          "id": 10507,
          "section": "第7条",
          "text": "项目库存不得未经批准转为公共库存，归属变化需保留记录。"
        },
        {
          "id": 10508,
          "section": "第8条",
          "text": "盘点记录保存3年；不得为消除差异而直接删除库存流水。"
        }
      ]
    },
    {
      "id": 1007,
      "name": "采购价格参考规则（演示）",
      "version": "2.0",
      "demo": true,
      "chunks": [
        {
          "id": 10601,
          "section": "第1条",
          "text": "订单价格偏离率等于成交单价与生效参考价之差除以参考价，按绝对值判定关注等级。"
        },
        {
          "id": 10602,
          "section": "第2条",
          "text": "价格偏离率达到5%时提示关注，达到15%时提示显著偏离，均需结合业务原因判断。"
        },
        {
          "id": 10603,
          "section": "第3条",
          "text": "参考价变更创建新版本；订单保留下单时使用的参考价快照。"
        },
        {
          "id": 10604,
          "section": "第4条",
          "text": "历史均价采用采购金额总和除以数量总和的加权口径，不对各单价直接求平均。"
        },
        {
          "id": 10605,
          "section": "第5条",
          "text": "没有有效参考价时不计算价格偏离，不得把缺失参考价当成0元。"
        },
        {
          "id": 10606,
          "section": "第6条",
          "text": "最近成交价展示来源订单编号与日期，参考价不等于最近成交价。"
        },
        {
          "id": 10607,
          "section": "第7条",
          "text": "价格偏离提示只供审批核对，不自动拒绝订单，也不替代主管审批。"
        },
        {
          "id": 10608,
          "section": "第8条",
          "text": "无成交样本时成交均价显示暂无数据，不生成虚构价格。"
        }
      ]
    },
    {
      "id": 1008,
      "name": "数据权限与问答规范（演示）",
      "version": "2.0",
      "demo": true,
      "chunks": [
        {
          "id": 10701,
          "section": "第1条",
          "text": "采购员查询业务单据时只返回授权部门数据，不能通过修改筛选参数扩大范围。"
        },
        {
          "id": 10702,
          "section": "第2条",
          "text": "历史会话仅限创建该会话的账号访问，重跑查询仍需重新执行权限检查。"
        },
        {
          "id": 10703,
          "section": "第3条",
          "text": "制度答案只依据启用且有效的知识库片段，旧版本仅供历史参考。"
        },
        {
          "id": 10704,
          "section": "第4条",
          "text": "模型关闭、超时或输出校验失败时只展示参考片段；没有依据时明确拒答。"
        },
        {
          "id": 10705,
          "section": "第5条",
          "text": "数据查询出现同名实体时先澄清，不得默认选择第1个候选对象。"
        },
        {
          "id": 10706,
          "section": "第6条",
          "text": "助手仅提供查询和问答，不能代替用户审批、确认入库或删除业务单据。"
        },
        {
          "id": 10707,
          "section": "第7条",
          "text": "演示材料均为虚构制度，不代表真实企业规范或法律意见。"
        },
        {
          "id": 10708,
          "section": "第8条",
          "text": "操作审计记录执行账号、业务动作和结果；密钥与密码不写入日志。"
        }
      ]
    }
  ]
}
